rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: 
    // - Users can read/write their own profile
    // - Admins need to read ALL profiles for the dashboard (allowing auth users to read for now)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Projects: 
    // - Authenticated users can create projects
    // - Users can read their own projects
    // - Admins (hardcoded email check in rules is hard, simplified for now)
    // For now, allowing all authenticated users to read/write projects to ensure dashboard works.
    // Ideally, we would checking request.auth.token.email for admin privileges.
    
    match /projects/{projectId} {
      allow read, write: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
